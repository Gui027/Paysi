DATABASE_URL=jdbc:postgresql://localhost:5432/paysi
DATABASE_USER=paysi_app
DATABASE_PASSWORD=paysi_app
DATABASE_MIGRATION_USER=paysi
DATABASE_MIGRATION_PASSWORD=paysi
REDIS_HOST=localhost
REDIS_PORT=6379
RABBIT_HOST=localhost
RABBIT_PORT=5672
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SSL_PROTOCOLS=TLSv1.2 TLSv1.3
PAYSI_WEB_BASE_URL=http://localhost:3000
PAYSI_ALLOWED_ORIGINS=http://localhost:5173
PAYSI_MAIL_FROM=nao-responda@paysi.local
KYC_PROVIDER=configured
KYC_PROVIDER_BASE_URL=https://kyc.local/process
KYC_WEBHOOK_SECRET=
PAYSI_PROVIDER=fake
PAYSI_FISCAL=fake
JWT_SECRET=
COLUMN_ENCRYPTION_KEY_REF=
API_KEY_PEPPER_REF=
# Chave criptográfica de produção: somente no secret protegido
# MFA_ENCRYPTION_KEY_BASE64 do GitHub Environment. Em desenvolvimento, injete
# uma chave descartável apenas na sessão do terminal.
PAYOUT_MFA_THRESHOLD_CENTS=100000
PAYMENT_FAKE_OUTCOME=APPROVED
PAYMENT_WEBHOOK_SECRET=
VAULT_ADDR=
# Não grave ASAAS_API_KEY neste arquivo nem em .env. Em desenvolvimento, injete
# a chave Sandbox apenas na sessão do terminal. Em produção, o deploy a recebe
# do secret protegido ASAAS_API_KEY do GitHub Environment "staging".
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
PAYSI_SIGNUP_ALLOWED_EMAILS=
